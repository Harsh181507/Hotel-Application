# Copy this file to ".env" and fill in real values. Never commit .env to git.

PORT=4000
NODE_ENV=development

# PostgreSQL connection. The default matches docker-compose.yml.
# In production use your hosted DB URL (Neon, Supabase, Render, Railway...).
DATABASE_URL=postgres://anemos:anemos@localhost:5433/anemos

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the frontend lives (used for CORS and for building room QR links).
# Comma-separate multiple origins.
CORS_ORIGINS=http://localhost:5173
GUEST_APP_URL=http://localhost:5173

# Optional: set when running more than one server instance so live chat
# messages reach every instance. Leave empty for a single server.
REDIS_URL=

# Used only by "npm run db:seed" to create the first admin login.
SEED_ADMIN_EMAIL=admin@anemos.local
SEED_ADMIN_PASSWORD=ChangeMe123!
